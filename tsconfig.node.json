{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["domain/*"],
      "@main/*": ["app/main/*"]
    }
  },
  "include": ["app/main/**/*", "app/preload/**/*", "domain/**/*", "scripts/**/*", "tests/**/*", "electron.vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
